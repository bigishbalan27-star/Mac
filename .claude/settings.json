{
  "extraKnownMarketplaces": {
    "remocn": {
      "source": {
        "source": "directory",
        "path": "./.claude/marketplaces/remocn"
      }
    },
    "buildwithclaude": {
      "source": {
        "source": "github",
        "repo": "davepoon/buildwithclaude"
      }
    },
    "marketingskills": {
      "source": {
        "source": "github",
        "repo": "coreyhaines31/marketingskills"
      }
    }
  },
  "enabledPlugins": {
    "remocn@remocn": true,
    "agents-media-content@buildwithclaude": true,
    "agents-sales-marketing@buildwithclaude": true,
    "agents-design-experience@buildwithclaude": true,
    "marketing-skills@marketingskills": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
