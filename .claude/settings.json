{
  "extraKnownMarketplaces": {
    "remocn": {
      "source": {
        "source": "directory",
        "path": "./.claude/marketplaces/remocn"
      }
    },
    "buildwithclaude": {
      "source": {
        "source": "github",
        "repo": "davepoon/buildwithclaude"
      }
    },
    "marketingskills": {
      "source": {
        "source": "github",
        "repo": "coreyhaines31/marketingskills"
      }
    },
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/everything-claude-code"
      }
    },
    "claudex-loop": {
      "source": {
        "source": "github",
        "repo": "chaseai-yt/claudex-loop"
      }
    }
  },
  "enabledPlugins": {
    "remocn@remocn": true,
    "agents-media-content@buildwithclaude": true,
    "agents-sales-marketing@buildwithclaude": true,
    "agents-design-experience@buildwithclaude": true,
    "marketing-skills@marketingskills": true,
    "ecc@ecc": true,
    "claudex-loop@claudex-loop": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 && { graphify hook install >/dev/null 2>&1; graphify update . >/dev/null 2>&1; }; exit 0",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
